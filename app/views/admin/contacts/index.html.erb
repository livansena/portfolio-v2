<h1>Contact</h1>

<table border="1" cellpadding="10">

  <thead>
    <tr>
      <th>Tag</th>
      <th>Title</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>

    <% @contacts.each do |contact| %>

      <tr>

        <td><%= contact.tag %></td>

        <td><%= contact.title %></td>

        <td>
          <% if contact.status == "published" %>

            <span style="color:#00f5b4;font-weight:bold;">
              Published
            </span>

          <% else %>

            <span style="color:#888;">
              Draft
            </span>

          <% end %>
        </td>

        <td>
          <%= link_to "Edit", edit_admin_contact_path(contact) %>
        </td>

      </tr>

    <% end %>

  </tbody>

</table>