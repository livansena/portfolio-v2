<%= form_with model: [:admin, @hero] do |form| %>

  <div class="admin-card">

    <!-- ==========================================================
         CARD HEADER
         ========================================================== -->

    <div class="admin-card-header">

      <h2>Hero Content</h2>

      <p>
        Update the main section displayed on the homepage.
      </p>

    </div>

    <!-- ==========================================================
         CARD BODY
         ========================================================== -->

    <div class="admin-card-body">

      <!-- ======================================================
           HERO INFORMATION
           ====================================================== -->

      <div class="admin-form-grid">

        <div class="admin-form-group">

          <%= form.label :hero_tag, "Hero Tag", class: "admin-label" %>

          <%= form.text_field :hero_tag,
                class: "admin-input" %>

        </div>

        <div class="admin-form-group">

          <%= form.label :title_line_1,
                "Title Line 1",
                class: "admin-label" %>

          <%= form.text_field :title_line_1,
                class: "admin-input" %>

        </div>

        <div class="admin-form-group">

          <%= form.label :title_line_2,
                "Title Line 2",
                class: "admin-label" %>

          <%= form.text_field :title_line_2,
                class: "admin-input" %>

        </div>

        <div class="admin-form-group">

          <%= form.label :title_highlight,
                "Title Highlight",
                class: "admin-label" %>

          <%= form.text_field :title_highlight,
                class: "admin-input" %>

        </div>

      </div>

      <!-- ======================================================
           DESCRIPTION
           ====================================================== -->

      <div class="admin-form-group">

        <%= form.label :description,
              "Description",
              class: "admin-label" %>

        <%= form.text_area :description,
              rows: 6,
              class: "admin-textarea" %>

      </div>

      <!-- ======================================================
           PRIMARY BUTTON
           ====================================================== -->

      <div class="admin-form-grid">

        <div class="admin-form-group">

          <%= form.label :primary_button_text,
                "Primary Button Text",
                class: "admin-label" %>

          <%= form.text_field :primary_button_text,
                class: "admin-input" %>

        </div>

        <div class="admin-form-group">

          <%= form.label :primary_button_url,
                "Primary Button URL",
                class: "admin-label" %>

          <%= form.text_field :primary_button_url,
                class: "admin-input" %>

        </div>

      </div>

      <!-- ======================================================
           SECONDARY BUTTON
           ====================================================== -->

      <div class="admin-form-grid">

        <div class="admin-form-group">

          <%= form.label :secondary_button_text,
                "Secondary Button Text",
                class: "admin-label" %>

          <%= form.text_field :secondary_button_text,
                class: "admin-input" %>

        </div>

        <div class="admin-form-group">

          <%= form.label :secondary_button_url,
                "Secondary Button URL",
                class: "admin-label" %>

          <%= form.text_field :secondary_button_url,
                class: "admin-input" %>

        </div>

      </div>

      <!-- ======================================================
           HERO IMAGE
           ====================================================== -->

      <div class="admin-form-group">

        <%= form.label :image,
              "Hero Image",
              class: "admin-label" %>

        <% if @hero.image.attached? %>

          <div class="admin-image-preview">

            <%= image_tag @hero.image, width: 240 %>

          </div>

        <% end %>

        <%= form.file_field :image %>

      </div>

      <!-- ======================================================
           RESUME
           ====================================================== -->

      <div class="admin-form-group">

        <%= form.label :resume,
              "Resume (PDF)",
              class: "admin-label" %>

        <% if @hero.resume.attached? %>

          <p class="admin-help">

            Current file:

            <%= link_to @hero.resume.filename,
                        url_for(@hero.resume),
                        target: "_blank" %>

          </p>

        <% end %>

        <%= form.file_field :resume,
              accept: "application/pdf" %>

      </div>

      <!-- ======================================================
           STATUS
           ====================================================== -->

      <div class="admin-form-group">

        <%= form.label :status,
              "Status",
              class: "admin-label" %>

        <%= form.select :status,
              [["Draft", "draft"], ["Published", "published"]],
              {},
              class: "admin-select" %>

      </div>

      <!-- ======================================================
           ACTIONS
           ====================================================== -->

      <div class="admin-form-actions">

        <%= link_to "Cancel",
              admin_root_path,
              class: "admin-secondary-btn" %>

        <%= form.submit "Save Changes",
              class: "admin-primary-btn" %>

      </div>

    </div>

  </div>

<% end %>