<%= form_with model: [:admin, @project] do |form| %>

  <div>
    <%= form.label :title %><br>
    <%= form.text_field :title %>
  </div>

  <br>

  <div>
    <%= form.label :slug %><br>
    <%= form.text_field :slug %>
  </div>

  <br>

  <div>
    <%= form.label :description %><br>
    <%= form.text_area :description, rows: 5 %>
  </div>

  <br>

  <div>
  <%= form.label :image %><br>
  <%= form.file_field :image %>
    </div>

  <br>

  <div>
    <%= form.label :github_url %><br>
    <%= form.text_field :github_url %>
  </div>

  <br>

  <div>
    <%= form.label :demo_url %><br>
    <%= form.text_field :demo_url %>
  </div>

  <br>

  <div>
    <%= form.label :position %><br>
    <%= form.number_field :position %>
  </div>

  <br>

  <div>
    <%= form.check_box :featured %>
    <%= form.label :featured %>
  </div>

  <br>

  <%= form.submit %>

<% end %>