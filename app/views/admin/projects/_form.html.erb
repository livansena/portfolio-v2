<%= form_with model: [:admin, @project] do |form| %>

  <% if @project.errors.any? %>

  <div style="
      background:#3b1111;
      color:#ffb4b4;
      border:1px solid #a94442;
      padding:18px;
      border-radius:10px;
      margin-bottom:25px;
  ">

    <h3>
      <%= pluralize(@project.errors.count, "error") %>
      prevented this project from being saved:
    </h3>

    <ul>

      <% @project.errors.full_messages.each do |message| %>

        <li><%= message %></li>

      <% end %>

    </ul>

   </div>

   <% end %>

  <div>
    <%= form.label :title %><br>
    <%= form.text_field :title %>
  </div>

  <br>

  <% if @project.persisted? %>

  <div>
    <%= form.label :slug %><br>
    <%= form.text_field :slug %>
  </div>

  <br>

  <% end %>

  <div>
    <%= form.label :description %><br>
    <%= form.text_area :description, rows: 5 %>
  </div>

  <br>

  <div>

  <%= form.label :image %><br>

  <% if @project.persisted? && @project.image.attached? %>

    <div style="margin:15px 0;">

      <%= image_tag @project.image,
            width: 350,
            style: "border-radius:12px;border:1px solid #2f3652;" %>

    </div>

  <% end %>

  <%= form.file_field :image %>

  <% if @project.persisted? && @project.image.attached? %>

  <br><br>

  <%= link_to "Remove current image",
      remove_image_admin_project_path(@project),
      data: {
        turbo_method: :delete,
        turbo_confirm: "Remove this image?"
      } %>
      <% end %>

</div>

  <br>

  <div>
    <%= form.label :github_url %><br>
    <%= form.text_field :github_url %>
  </div>

  <br>

  <div>
    <%= form.label :demo_url %><br>
    <%= form.text_field :demo_url %>
  </div>

  <br>

  <div>
    <%= form.label :position %><br>
    <%= form.number_field :position %>
  </div>

  <br>

  <div>
    <%= form.check_box :featured %>
    <%= form.label :featured %>
  </div>

  <br>

  <hr>

<h3>Technologies</h3>

<div>

  <% @technologies.each do |technology| %>

    <div>

      <%= check_box_tag(
            "project[technology_ids][]",
            technology.id,
            @project.technology_ids.include?(technology.id)
          ) %>

      <%= technology.name %>

    </div>

  <% end %>

</div>

<br>

  <%= form.submit %>

<% end %>