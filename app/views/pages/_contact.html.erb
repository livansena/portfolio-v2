<div data-controller="contact-modal">

  <!-- ==========================================================
       CONTACT SECTION
       ========================================================== -->

  <section
    id="contact"
    class="contact-section">

    <!-- ==========================================================
         CONTACT HEADER
         ========================================================== -->

    <div class="contact-header">

      <span class="section-tag">
        <%= @contact.tag %>
      </span>

      <h2>
        <%= @contact.title %>
      </h2>

      <p>
        <%= @contact.subtitle %>
      </p>

    </div>

    <!-- ==========================================================
         CONTACT LINKS
         ========================================================== -->

    <div class="contact-links">

      <button
        type="button"
        class="contact-btn"
        data-action="click->contact-modal#open">

        <i class="fa-solid fa-envelope"></i>

        Email

      </button>

      <a
        href="<%= @contact.linkedin_url %>"
        target="_blank"
        rel="noopener"
        class="contact-btn">

        <i class="fa-brands fa-linkedin"></i>

        LinkedIn

      </a>

      <a
        href="<%= @contact.github_url %>"
        target="_blank"
        rel="noopener"
        class="contact-btn">

        <i class="fa-brands fa-github"></i>

        GitHub

      </a>

      <a
        href="<%= @contact.resume_url %>"
        target="_blank"
        rel="noopener"
        class="contact-btn">

        <i class="fa-solid fa-file-lines"></i>

        Resume

      </a>

    </div>

  </section>

  <!-- ==========================================================
       CONTACT MODAL
       ========================================================== -->

  <div
    id="contact-modal"
    class="contact-modal"
    data-contact-modal-target="modal"
    data-action="click->contact-modal#closeBackground">

    <div class="contact-modal-content">

      <!-- ======================================================
           CLOSE BUTTON
           ====================================================== -->

      <button
        type="button"
        class="contact-modal-close"
        data-action="click->contact-modal#close">

        &times;

      </button>

      <!-- ======================================================
           MODAL HEADER
           ====================================================== -->

      <h3>
        Send me a message
      </h3>

      <p class="contact-modal-subtitle">
        Have a project, opportunity or question?
        I'd love to hear from you.
      </p>

      <!-- ======================================================
           CONTACT FORM
           ====================================================== -->

      <div id="contact-form">
        <%= render "pages/contact_form" %>
      </div>

    </div>

  </div>

</div>