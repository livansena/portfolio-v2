<div data-controller="contact-modal">

  <!-- ==========================================================
       CONTACT SECTION
       ========================================================== -->

  <section
    id="contact"
    class="contact-section">

    <!-- ==========================================================
         CONTACT HEADER
         ========================================================== -->

    <div class="contact-header">

      <span class="section-tag">
        <%= @contact.tag %>
      </span>

      <h2>
        <%= @contact.title %>
      </h2>

      <p>
        <%= @contact.subtitle %>
      </p>

    </div>

    <!-- ==========================================================
         CONTACT LINKS
         ========================================================== -->

    <div class="contact-links">

      <button
        type="button"
        class="contact-btn"
        data-action="click->contact-modal#open">

        <i class="fa-solid fa-envelope"></i>

        Email

      </button>

      <a
        href="<%= @contact.linkedin_url %>"
        target="_blank"
        rel="noopener"
        class="contact-btn">

        <i class="fa-brands fa-linkedin"></i>

        LinkedIn

      </a>

      <a
        href="<%= @contact.github_url %>"
        target="_blank"
        rel="noopener"
        class="contact-btn">

        <i class="fa-brands fa-github"></i>

        GitHub

      </a>

      <a
        href="<%= @contact.resume_url %>"
        target="_blank"
        rel="noopener"
        class="contact-btn">

        <i class="fa-solid fa-file-lines"></i>

        Resume

      </a>

    </div>

  </section>

  <!-- ==========================================================
       CONTACT MODAL
       ========================================================== -->

  <div
    id="contact-modal"
    class="contact-modal"
    data-contact-modal-target="modal"
    data-action="click->contact-modal#closeBackground">

    <div class="contact-modal-content">

      <!-- ======================================================
           CLOSE BUTTON
           ====================================================== -->

      <button
        type="button"
        class="contact-modal-close"
        data-action="click->contact-modal#close">

        &times;

      </button>

      <!-- ======================================================
           MODAL HEADER
           ====================================================== -->

      <h3>
        Send me a message
      </h3>

      <p class="contact-modal-subtitle">
        Have a project, opportunity or question?
        I'd love to hear from you.
      </p>

      <!-- ======================================================
           CONTACT FORM
           ====================================================== -->

      <%= form_with url: contact_path,
                    method: :post,
                    local: true,
                    data: {
                      action: "submit->contact-modal#submit"
                    } do |form| %>

        <!-- Name -->

        <div class="form-group">

          <%= form.label :name, "Your Name" %>

          <%= form.text_field :name,
                placeholder: "John Doe",
                required: true %>

        </div>

        <!-- Email -->

        <div class="form-group">

          <%= form.label :email, "Your Email" %>

          <%= form.email_field :email,
                placeholder: "your@email.com",
                required: true %>

        </div>

        <!-- Subject -->

        <div class="form-group">

          <%= form.label :subject, "Subject" %>

          <%= form.text_field :subject,
                placeholder: "How can I help you?",
                required: true %>

        </div>

        <!-- Message -->

        <div class="form-group">

          <%= form.label :message, "Message" %>

          <%= form.text_area :message,
                rows: 6,
                placeholder: "Write your message here...",
                required: true %>

        </div>

        <!-- Actions -->

        <div class="contact-modal-actions">

          <button
            type="button"
            class="secondary-btn"
            data-action="click->contact-modal#close">

            Cancel

          </button>

          <%= form.submit "Send Message",
                class: "primary-btn",
                data: {
                  contact_modal_target: "submitButton"
                } %>

        </div>

      <% end %>

    </div>

  </div>

</div>