<section class="hero" id="home">

  <div class="hero-content">

    <span class="hero-tag">
      <%= @hero.hero_tag %>
    </span>

    <h1>
      <%= @hero.title_line_1 %><br>
      <%= @hero.title_line_2 %><br>

      <span class="hero-highlight">
        <%= @hero.title_highlight %>
      </span>
    </h1>

    <p>
      <%= @hero.description %>
    </p>

    <div class="hero-buttons">

  <%= link_to @hero.primary_button_text,
              @hero.primary_button_url,
              class: "primary-btn" %>

  <% if @hero.resume.attached? %>

    <%= link_to @hero.secondary_button_text,
                url_for(@hero.resume),
                target: "_blank",
                rel: "noopener",
                class: "secondary-btn" %>

  <% else %>

    <%= link_to @hero.secondary_button_text,
                @hero.secondary_button_url,
                class: "secondary-btn" %>

  <% end %>

</div>

  </div>

  <div class="hero-image">

  <% if @hero.image.attached? %>

    <%= image_tag @hero.image,
                  alt: "Livan Passos" %>

  <% else %>

    <%= image_tag "profile.png",
                  alt: "Livan Passos" %>

  <% end %>

</div>

</section>