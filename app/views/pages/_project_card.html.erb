<div class="project-card">

  <% if project.image.attached? %>
    <div class="project-image">
      <%= image_tag project.image, alt: project.title %>
    </div>
  <% end %>

  <div class="project-content">

    <h3><%= project.title %></h3>

    <p><%= project.description %></p>

    <% if project.technologies.any? %>
      <div class="project-stack">
        <% project.technologies.each do |tech| %>
          <span><%= tech.name %></span>
        <% end %>
      </div>
    <% end %>

    <div class="project-links">

      <% if project.demo_url.present? %>
        <%= link_to "Live Demo",
              project.demo_url,
              class: "project-btn" %>
      <% end %>

      <% if project.github_url.present? %>
        <%= link_to "GitHub",
              project.github_url,
              class: "project-btn secondary",
              target: "_blank" %>
      <% end %>

    </div>

  </div>

</div>