<header class="admin-header">

  <div class="admin-header-content">

    <div>

      <h1>

        <%= @page_title %>

      </h1>

      <p>

        <%= @page_description %>

      </p>

    </div>

    <% if @page_action_text.present? && @page_action_path.present? %>

      <%= link_to @page_action_text,
            @page_action_path,
            class: "admin-primary-btn" %>

    <% end %>

  </div>

</header>